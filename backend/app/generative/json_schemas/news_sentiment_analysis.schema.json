{
  "type": "object",
  "required": [
    "schema_version",
    "analysis_type",
    "ticker",
    "news_id",
    "generated_at",
    "sentiment",
    "impact",
    "time_horizon",
    "confidence",
    "summary",
    "evidence",
    "risks",
    "not_financial_advice"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "analysis_type": { "const": "news_sentiment_analysis" },
    "ticker": { "type": "string" },
    "news_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "sentiment": {
      "enum": ["positive", "negative", "neutral", "mixed", "unknown"]
    },
    "impact": { "enum": ["low", "medium", "high", "unknown"] },
    "time_horizon": {
      "enum": ["intraday", "short_term", "medium_term", "long_term", "unknown"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "not_financial_advice": { "const": true }
  },
  "additionalProperties": false
}
