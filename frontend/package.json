    "date-fns": "^4.1.0",
    "framer-motion": "^11.15.0",
    "i18next": "^26.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
